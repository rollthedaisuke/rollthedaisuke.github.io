{
  "name": "PDF Merger Pink",
  "short_name": "Merger Pink",
  "description": "View, print and merge PDFs. Files stay on your computer.",
  "start_url": "./pink.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#fdeef3",
  "theme_color": "#cf3a77",
  "icons": [
    {
      "src": "pink-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "pink-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./pink.html",
      "accept": {
        "application/pdf": [
          ".pdf"
        ]
      },
      "launch_type": "single-client"
    }
  ]
}
